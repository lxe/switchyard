+def _can_use_nvml_platform_query() -> bool:
+    # Scope the fast path to one visible GPU before any library initializes
+    # the CUDA driver. Torch's flag alone does not cover external CUDA users.
+    if (not current_platform.is_cuda() or torch.cuda.is_initialized()
+            or torch.cuda._device_count_nvml() != 1):
+        return False
+    visible_devices = torch.cuda._parse_visible_devices()
+    # CUDA numeric ordinals can differ from NVML ordering. UUID selection
+    # or a single physical GPU makes the physical identity unambiguous.
+    if (torch.cuda._raw_device_count_nvml() != 1
+            and not isinstance(visible_devices[0], str)):
+        return False
+    import ctypes
+
+    try:
+        context = ctypes.c_void_p()
+        # cuCtxGetCurrent does not call cuInit. Error 3 is precisely
+        # CUDA_ERROR_NOT_INITIALIZED; every other status retains native behavior.
+        return ctypes.CDLL("libcuda.so.1").cuCtxGetCurrent(ctypes.byref(context)) == 3
+    except (OSError, AttributeError):
+        return False
+
