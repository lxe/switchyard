+def _is_nvidia_hopper() -> bool:
+    if not is_nvidia:
+        return False
+    if _can_use_nvml_platform_query():
+        from vllm.platforms.cuda import pynvml, with_nvml_context
+
+        @with_nvml_context
+        def query() -> bool:
+            # Use Torch's actual visibility parser, including abbreviated UUIDs.
+            physical_id = torch.cuda._get_nvml_device_index(0)
+            handle = pynvml.nvmlDeviceGetHandleByIndex(physical_id)
+            if "NVIDIA H" in pynvml.nvmlDeviceGetName(handle):
+                return True
+            return pynvml.nvmlDeviceGetCudaComputeCapability(handle)[0] >= 9
+
+        try:
+            return query()
+        except (pynvml.NVMLError, RuntimeError, ValueError, IndexError, OSError):
+            pass
+    # Preserve the original visible-name/current-capability selection on
+    # initialized drivers, multiple GPUs, and every NVML query failure.
+    # Native CUDA initialization and vLLM's fork safety guard remain active.
+    return (
+        "NVIDIA H" in torch.cuda.get_device_name(0)
+        or torch.cuda.get_device_capability()[0] >= 9
+    )
+
+
