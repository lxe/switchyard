# syntax=docker/dockerfile:1
# The serving stack arrives as a verified artifact after the agent starts.
FROM --platform=linux/amd64 ubuntu:24.04@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b
LABEL io.switchyard.component="hydration-runtime"
ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    SWITCHYARD_RUNTIME_ROOT=/opt/switchyard/runtime
WORKDIR /opt/switchyard
# The provider bootstrap downloads and verifies the static Rust agent.
ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 https://snapshot.ubuntu.com/ubuntu/20261010T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb /tmp/bootstrap-ca.deb
RUN dpkg-deb -x /tmp/bootstrap-ca.deb /tmp/bootstrap-ca \
 && mkdir -p /etc/ssl/certs \
 && cat /tmp/bootstrap-ca/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt \
 && rm -rf /tmp/bootstrap-ca /tmp/bootstrap-ca.deb
RUN apt-get update --snapshot 20261010T000000Z \
 && apt-get install --snapshot 20261010T000000Z --no-install-recommends -y curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
CMD ["/bin/bash"]
